// Domain models are added module by module. Tables are snake_case plurals; columns stay camelCase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Staff and access (M1) ──────────────────────────────────────────────────────────────────

/// A named set of permissions. Roles are data: adding one needs no code change.
/// Permission names are validated against the list in @fernleaf/shared before they are saved.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  /// System roles (Admin) are locked: they can't be edited or deleted, and always have every
  /// permission, including ones added in later releases.
  isSystem    Boolean  @default(false)
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

/// A staff member who signs in to the panel (admin, kitchen, dispatch, driver…). Not a customer:
/// company employees are a separate model and never sign in.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Always stored lowercase (enforced by a CHECK constraint in the migration).
  email        String   @unique
  name         String
  passwordHash String
  roleId       String   @db.Uuid
  /// Restrict: a role in use can't be deleted.
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Staff are deactivated, never deleted, because history (who cooked, who delivered) refers to them.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([roleId])
  @@map("users")
}

// ─── Settings and reference data (M2) ───────────────────────────────────────────────────────

/// Platform-wide settings: exactly one row (id = 1, enforced by a CHECK constraint).
/// Typed columns rather than key/value pairs, so every value has a real type and constraint.
model PlatformSettings {
  id                        Int      @id @default(1)
  /// Weekdays the kitchen works: 0 = Sunday … 6 = Saturday.
  kitchenWorkingDays        Int[]
  /// Orders lock this many kitchen working days before delivery…
  cutoffDaysBefore          Int
  /// …at this kitchen wall-clock time (minutes after midnight, Asia/Kolkata).
  cutoffTimeMinutes         Int
  /// Planned kitchen-ready = planned dispatch-ready − this.
  kitchenReadyBufferMinutes Int
  /// Work not started within this many minutes of planned kitchen-ready is "at risk".
  atRiskMinutes             Int
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Days the kitchen is closed, as an inclusive date range. Skipped when counting back to a cut-off.
model KitchenHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([startDate, endDate])
  @@map("kitchen_holidays")
}

// Admin-managed lists. Same shape for each; items in use are deactivated rather than deleted
// (later tables reference them with ON DELETE RESTRICT, so the database refuses the delete).

model Allergen {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  dishes    DishAllergen[]
  options   OptionAllergen[]
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  @@map("allergens")
}

model DietaryTag {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)
  dishes    DishDietaryTag[]
  options   OptionDietaryTag[]
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  @@map("dietary_tags")
}

model KitchenStation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  dishes    Dish[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("kitchen_stations")
}

model PortionSize {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("portion_sizes")
}

model PackagingType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("packaging_types")
}

// ─── Catalogue (M3) ─────────────────────────────────────────────────────────────────────────

enum Temperature {
  HOT
  COLD
}

/// A dish on the catalogue. Deactivated, never deleted: past orders refer to it.
/// Selling prices live in price tiers (M4); costCents is the kitchen's own cost.
model Dish {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  description  String           @default("")
  /// Internal stock-keeping code, unique, uppercase (CHECK in the migration).
  sku          String           @unique
  temperature  Temperature
  /// What the dish costs the kitchen to make, in cents. Internal only.
  costCents    Int
  imageUrl     String?
  /// Null = "Unassigned" on the kitchen board.
  stationId    String?          @db.Uuid
  station      KitchenStation?  @relation(fields: [stationId], references: [id], onDelete: Restrict)
  /// Optional minimum quantity per order line (decision 10).
  minOrderQty  Int?
  isActive     Boolean          @default(true)
  allergens    DishAllergen[]
  dietaryTags  DishDietaryTag[]
  optionGroups OptionGroup[]
  prices       DishPrice[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@index([stationId])
  @@map("dishes")
}

// Join tables are explicit so deleting an allergen or tag that is in use is refused (RESTRICT),
// while removing it from a dish or option is just deleting the link row.

model DishAllergen {
  dishId     String   @db.Uuid
  allergenId String   @db.Uuid
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([dishId, allergenId])
  @@index([allergenId])
  @@map("dish_allergens")
}

model DishDietaryTag {
  dishId       String     @db.Uuid
  dietaryTagId String     @db.Uuid
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)

  @@id([dishId, dietaryTagId])
  @@index([dietaryTagId])
  @@map("dish_dietary_tags")
}

/// A reusable choice (paneer, jeera rice, raita…) offered by option groups on many dishes.
model Option {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  /// What the option costs the kitchen, in cents. Internal only.
  costCents   Int
  isActive    Boolean            @default(true)
  allergens   OptionAllergen[]
  dietaryTags OptionDietaryTag[]
  groupItems  OptionGroupItem[]
  prices      OptionPrice[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@map("options")
}

model OptionAllergen {
  optionId   String   @db.Uuid
  allergenId String   @db.Uuid
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([optionId, allergenId])
  @@index([allergenId])
  @@map("option_allergens")
}

model OptionDietaryTag {
  optionId     String     @db.Uuid
  dietaryTagId String     @db.Uuid
  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)

  @@id([optionId, dietaryTagId])
  @@index([dietaryTagId])
  @@map("option_dietary_tags")
}

/// A group of choices on one dish, e.g. "Choose your protein". Required = minSelect >= 1.
model OptionGroup {
  id        String            @id @default(uuid()) @db.Uuid
  dishId    String            @db.Uuid
  dish      Dish              @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int
  maxSelect Int
  /// Display order on the dish.
  sortOrder Int
  items     OptionGroupItem[]

  /// Lets OptionGroupItem reference (group, dish) together, so an item's dishId always matches its group.
  @@unique([id, dishId])
  @@index([dishId])
  @@map("option_groups")
}

/// An option offered by a group, in display order. dishId is copied from the group so the
/// database can enforce "an option appears in only one group of the same dish" (decision 62).
model OptionGroupItem {
  groupId   String      @db.Uuid
  dishId    String      @db.Uuid
  optionId  String      @db.Uuid
  sortOrder Int
  group     OptionGroup @relation(fields: [groupId, dishId], references: [id, dishId], onDelete: Cascade)
  /// Restrict: an option offered by a dish can't be deleted (deactivate it instead).
  option    Option      @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([groupId, optionId])
  @@unique([dishId, optionId])
  @@index([optionId])
  @@map("option_group_items")
}

// ─── Pricing (M4) ───────────────────────────────────────────────────────────────────────────

enum PriceRule {
  MANUAL
  COST_MULTIPLIER
  TIER_PERCENT
}

/// A named price list (Standard, Enterprise…). Exactly one is the default (partial unique index).
/// Derived prices are computed when read (packages/shared/src/pricing.ts); only typed prices are stored.
model PriceTier {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  description  String        @default("")
  isDefault    Boolean       @default(false)
  rule         PriceRule
  /// COST_MULTIPLIER: k in basis points (2.4 → 24000).
  multiplierBp Int?
  /// TIER_PERCENT: the base tier and the change in basis points (+15% → 1500).
  baseTierId   String?       @db.Uuid
  baseTier     PriceTier?    @relation("TierBase", fields: [baseTierId], references: [id], onDelete: Restrict)
  derivedTiers PriceTier[]   @relation("TierBase")
  percentBp    Int?
  dishPrices   DishPrice[]
  optionPrices OptionPrice[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@map("price_tiers")
}

/// A typed dish price: the price on a MANUAL tier, an override on a derived tier.
model DishPrice {
  tierId     String    @db.Uuid
  dishId     String    @db.Uuid
  priceCents Int
  tier       PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  dish       Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@id([tierId, dishId])
  @@index([dishId])
  @@map("dish_prices")
}

model OptionPrice {
  tierId     String    @db.Uuid
  optionId   String    @db.Uuid
  priceCents Int
  tier       PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  option     Option    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@id([tierId, optionId])
  @@index([optionId])
  @@map("option_prices")
}
