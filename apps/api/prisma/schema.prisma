// Domain models are added module by module. Tables are snake_case plurals; columns stay camelCase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Staff and access (M1) ──────────────────────────────────────────────────────────────────

/// A named set of permissions. Roles are data: adding one needs no code change.
/// Permission names are validated against the list in @fernleaf/shared before they are saved.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  /// System roles (Admin) are locked: they can't be edited or deleted, and always have every
  /// permission, including ones added in later releases.
  isSystem    Boolean  @default(false)
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

/// A staff member who signs in to the panel (admin, kitchen, dispatch, driver…). Not a customer:
/// company employees are a separate model and never sign in.
model User {
  id               String         @id @default(uuid()) @db.Uuid
  /// Always stored lowercase (enforced by a CHECK constraint in the migration).
  email            String         @unique
  name             String
  passwordHash     String
  roleId           String         @db.Uuid
  /// Restrict: a role in use can't be deleted.
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Staff are deactivated, never deleted, because history (who cooked, who delivered) refers to them.
  isActive         Boolean        @default(true)
  defaultDriverFor Company[]
  orderEvents      OrderEvent[]
  orderClosures    OrderClosure[]
  prepStarted      PrepUnit[]     @relation("PrepStartedBy")
  prepDone         PrepUnit[]     @relation("PrepDoneBy")
  assignedDrops    Drop[]
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@index([roleId])
  @@map("users")
}

// ─── Settings and reference data (M2) ───────────────────────────────────────────────────────

/// Platform-wide settings: exactly one row (id = 1, enforced by a CHECK constraint).
/// Typed columns rather than key/value pairs, so every value has a real type and constraint.
model PlatformSettings {
  id                         Int      @id @default(1)
  /// Weekdays the kitchen works: 0 = Sunday … 6 = Saturday.
  kitchenWorkingDays         Int[]
  /// Orders lock this many kitchen working days before delivery…
  cutoffDaysBefore           Int
  /// …at this kitchen wall-clock time (minutes after midnight, Asia/Kolkata).
  cutoffTimeMinutes          Int
  /// Planned kitchen-ready = planned dispatch-ready − this.
  kitchenReadyBufferMinutes  Int
  /// Work not started within this many minutes of planned kitchen-ready is "at risk".
  atRiskMinutes              Int
  /// Delivery times may be set between these kitchen times (decision 28).
  deliveryWindowStartMinutes Int      @default(480)
  deliveryWindowEndMinutes   Int      @default(1200)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Days the kitchen is closed, as an inclusive date range. Skipped when counting back to a cut-off.
model KitchenHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([startDate, endDate])
  @@map("kitchen_holidays")
}

// Admin-managed lists. Same shape for each; items in use are deactivated rather than deleted
// (later tables reference them with ON DELETE RESTRICT, so the database refuses the delete).

model Allergen {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)
  dishes    DishAllergen[]
  options   OptionAllergen[]
  employees EmployeeAllergen[]
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  @@map("allergens")
}

model DietaryTag {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @unique
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  dishes    DishDietaryTag[]
  options   OptionDietaryTag[]
  employees EmployeeDietaryTag[]
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)

  @@map("dietary_tags")
}

model KitchenStation {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  dishes     Dish[]
  orderLines OrderLine[]
  prepUnits  PrepUnit[]
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@map("kitchen_stations")
}

model PortionSize {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("portion_sizes")
}

model PackagingType {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  companies Company[]
  orders    Order[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@map("packaging_types")
}

// ─── Catalogue (M3) ─────────────────────────────────────────────────────────────────────────

enum Temperature {
  HOT
  COLD
}

/// A dish on the catalogue. Deactivated, never deleted: past orders refer to it.
/// Selling prices live in price tiers (M4); costCents is the kitchen's own cost.
model Dish {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  description  String           @default("")
  /// Internal stock-keeping code, unique, uppercase (CHECK in the migration).
  sku          String           @unique
  temperature  Temperature
  /// What the dish costs the kitchen to make, in cents. Internal only.
  costCents    Int
  imageUrl     String?
  /// Null = "Unassigned" on the kitchen board.
  stationId    String?          @db.Uuid
  station      KitchenStation?  @relation(fields: [stationId], references: [id], onDelete: Restrict)
  /// Optional minimum quantity per order line (decision 10).
  minOrderQty  Int?
  isActive     Boolean          @default(true)
  allergens    DishAllergen[]
  dietaryTags  DishDietaryTag[]
  optionGroups OptionGroup[]
  prices       DishPrice[]
  menuItems    MenuItem[]
  orderLines   OrderLine[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@index([stationId])
  @@map("dishes")
}

// Join tables are explicit so deleting an allergen or tag that is in use is refused (RESTRICT),
// while removing it from a dish or option is just deleting the link row.

model DishAllergen {
  dishId     String   @db.Uuid
  allergenId String   @db.Uuid
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([dishId, allergenId])
  @@index([allergenId])
  @@map("dish_allergens")
}

model DishDietaryTag {
  dishId       String     @db.Uuid
  dietaryTagId String     @db.Uuid
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)

  @@id([dishId, dietaryTagId])
  @@index([dietaryTagId])
  @@map("dish_dietary_tags")
}

/// A reusable choice (paneer, jeera rice, raita…) offered by option groups on many dishes.
model Option {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  /// What the option costs the kitchen, in cents. Internal only.
  costCents   Int
  isActive    Boolean            @default(true)
  allergens   OptionAllergen[]
  dietaryTags OptionDietaryTag[]
  groupItems  OptionGroupItem[]
  prices      OptionPrice[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@map("options")
}

model OptionAllergen {
  optionId   String   @db.Uuid
  allergenId String   @db.Uuid
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([optionId, allergenId])
  @@index([allergenId])
  @@map("option_allergens")
}

model OptionDietaryTag {
  optionId     String     @db.Uuid
  dietaryTagId String     @db.Uuid
  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)

  @@id([optionId, dietaryTagId])
  @@index([dietaryTagId])
  @@map("option_dietary_tags")
}

/// A group of choices on one dish, e.g. "Choose your protein". Required = minSelect >= 1.
model OptionGroup {
  id        String            @id @default(uuid()) @db.Uuid
  dishId    String            @db.Uuid
  dish      Dish              @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int
  maxSelect Int
  /// Display order on the dish.
  sortOrder Int
  items     OptionGroupItem[]

  /// Lets OptionGroupItem reference (group, dish) together, so an item's dishId always matches its group.
  @@unique([id, dishId])
  @@index([dishId])
  @@map("option_groups")
}

/// An option offered by a group, in display order. dishId is copied from the group so the
/// database can enforce "an option appears in only one group of the same dish" (decision 62).
model OptionGroupItem {
  groupId   String      @db.Uuid
  dishId    String      @db.Uuid
  optionId  String      @db.Uuid
  sortOrder Int
  group     OptionGroup @relation(fields: [groupId, dishId], references: [id, dishId], onDelete: Cascade)
  /// Restrict: an option offered by a dish can't be deleted (deactivate it instead).
  option    Option      @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([groupId, optionId])
  @@unique([dishId, optionId])
  @@index([optionId])
  @@map("option_group_items")
}

// ─── Pricing (M4) ───────────────────────────────────────────────────────────────────────────

enum PriceRule {
  MANUAL
  COST_MULTIPLIER
  TIER_PERCENT
}

/// A named price list (Standard, Enterprise…). Exactly one is the default (partial unique index).
/// Derived prices are computed when read (packages/shared/src/pricing.ts); only typed prices are stored.
model PriceTier {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  description  String        @default("")
  isDefault    Boolean       @default(false)
  rule         PriceRule
  /// COST_MULTIPLIER: k in basis points (2.4 → 24000).
  multiplierBp Int?
  /// TIER_PERCENT: the base tier and the change in basis points (+15% → 1500).
  baseTierId   String?       @db.Uuid
  baseTier     PriceTier?    @relation("TierBase", fields: [baseTierId], references: [id], onDelete: Restrict)
  derivedTiers PriceTier[]   @relation("TierBase")
  percentBp    Int?
  dishPrices   DishPrice[]
  optionPrices OptionPrice[]
  companies    Company[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@map("price_tiers")
}

/// A typed dish price: the price on a MANUAL tier, an override on a derived tier.
model DishPrice {
  tierId     String    @db.Uuid
  dishId     String    @db.Uuid
  priceCents Int
  tier       PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  dish       Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@id([tierId, dishId])
  @@index([dishId])
  @@map("dish_prices")
}

model OptionPrice {
  tierId     String    @db.Uuid
  optionId   String    @db.Uuid
  priceCents Int
  tier       PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  option     Option    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@id([tierId, optionId])
  @@index([optionId])
  @@map("option_prices")
}

// ─── Companies (M5) ─────────────────────────────────────────────────────────────────────────

/// A client company. Its employees order meals; every order is billed to the company.
model Company {
  id                         String                  @id @default(uuid()) @db.Uuid
  name                       String                  @unique
  /// Deactivated companies take no new orders; existing orders carry on (decision 31).
  isActive                   Boolean                 @default(true)
  /// Null = the default tier (brief 4.3.4).
  priceTierId                String?                 @db.Uuid
  priceTier                  PriceTier?              @relation(fields: [priceTierId], references: [id], onDelete: Restrict)
  billingContactName         String
  billingEmail               String
  billingPhone               String                  @default("")
  /// Days the company can receive deliveries: 0 = Sunday … 6 = Saturday. Never moves the cut-off.
  workingDays                Int[]
  /// Kitchen wall-clock minutes, quarter hours (e.g. 750 = 12:30).
  defaultDeliveryTimeMinutes Int
  /// Minutes before delivery the order must leave the kitchen (brief default 60).
  dispatchLeadMinutes        Int                     @default(60)
  defaultPackagingTypeId     String                  @db.Uuid
  defaultPackagingType       PackagingType           @relation(fields: [defaultPackagingTypeId], references: [id], onDelete: Restrict)
  driverInstructions         String                  @default("")
  defaultDriverId            String?                 @db.Uuid
  defaultDriver              User?                   @relation(fields: [defaultDriverId], references: [id], onDelete: Restrict)
  domains                    CompanyDomain[]
  addresses                  CompanyAddress[]
  holidays                   CompanyHoliday[]
  hiddenCategories           CompanyHiddenCategory[]
  hiddenMenuItems            CompanyHiddenMenuItem[]
  employees                  Employee[]              @relation("CompanyEmployees")
  orders                     Order[]
  drops                      Drop[]
  invoices                   Invoice[]
  /// The company owner: one of its own employees (composite FK on (ownerId, id) → employees(id, companyId)).
  ownerId                    String?                 @db.Uuid
  owner                      Employee?               @relation("CompanyOwner", fields: [ownerId, id], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)

  @@index([priceTierId])
  @@map("companies")
}

/// An email domain a company owns. Unique across all companies (brief 4.4); stored lowercase.
model CompanyDomain {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  domain    String  @unique

  @@index([companyId])
  @@map("company_domains")
}

/// A delivery address. One per company is the default (partial unique index).
model CompanyAddress {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label         String
  line1         String
  line2         String   @default("")
  city          String
  postcode      String
  deliveryNotes String   @default("")
  isDefault     Boolean  @default(false)
  orders        Order[]
  drops         Drop[]
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([companyId])
  @@map("company_addresses")
}

/// Days the company can't receive deliveries. Unlike kitchen closures, these never move the cut-off.
model CompanyHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  @@index([companyId, startDate])
  @@map("company_holidays")
}

// ─── Employees (M6) ─────────────────────────────────────────────────────────────────────────

/// A person meals are ordered for. Never signs in. Belongs to exactly one company; their email must
/// be on one of the company's domains (checked in the app). Not deleted (orders refer to them).
model Employee {
  id                    String               @id @default(uuid()) @db.Uuid
  companyId             String               @db.Uuid
  company               Company              @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Restrict)
  name                  String
  /// Unique across all companies, lowercase (CHECK).
  email                 String               @unique
  phone                 String               @default("")
  canChooseAddress      Boolean              @default(false)
  canChangeDeliveryTime Boolean              @default(false)
  canChangePackaging    Boolean              @default(false)
  allergies             EmployeeAllergen[]
  dietaryPreferences    EmployeeDietaryTag[]
  orders                Order[]
  ownerOf               Company[]            @relation("CompanyOwner")
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  /// Target of the company-owner FK, so an owner always belongs to the company it owns.
  @@unique([id, companyId])
  @@index([companyId, name])
  @@map("employees")
}

// ─── Orders (M8) ────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  DELIVERED
  CANCELLED
  REJECTED
}

model Order {
  id                     String         @id @default(uuid()) @db.Uuid
  sequence               Int            @unique @default(autoincrement())
  employeeId             String         @db.Uuid
  employee               Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName           String
  companyId              String         @db.Uuid
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyName            String
  deliveryDate           DateTime       @db.Date
  deliveryTimeMinutes    Int
  addressId              String         @db.Uuid
  address                CompanyAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  addressText            String
  packagingTypeId        String         @db.Uuid
  packagingType          PackagingType  @relation(fields: [packagingTypeId], references: [id], onDelete: Restrict)
  packagingName          String
  notes                  String         @default("")
  driverInstructions     String         @default("")
  dispatchLeadMinutes    Int
  kitchenBufferMinutes   Int
  plannedKitchenReadyAt  DateTime       @db.Timestamptz(3)
  plannedDispatchReadyAt DateTime       @db.Timestamptz(3)
  cutoffAt               DateTime       @db.Timestamptz(3)
  status                 OrderStatus    @default(DRAFT)
  totalCents             Int
  invoiceId              String?        @db.Uuid
  invoice                Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  billingReviewReason    String         @default("")
  shortDeliveryNote      String         @default("")
  version                Int            @default(0)
  kitchenStartedAt       DateTime?      @db.Timestamptz(3)
  kitchenReadyAt         DateTime?      @db.Timestamptz(3)
  outForDeliveryAt       DateTime?      @db.Timestamptz(3)
  dropId                 String?        @db.Uuid
  drop                   Drop?          @relation(fields: [dropId], references: [id], onDelete: Restrict)
  lines                  OrderLine[]
  events                 OrderEvent[]
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, cutoffAt])
  @@index([deliveryDate, deliveryTimeMinutes])
  @@index([companyId, deliveryDate])
  @@index([employeeId])
  @@index([dropId])
  @@index([invoiceId])
  @@map("orders")
}

model Invoice {
  id                 String    @id @default(uuid()) @db.Uuid
  sequence           Int       @unique @default(autoincrement())
  companyId          String    @db.Uuid
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyName        String
  billingContactName String
  billingEmail       String
  totalCents         Int
  orderCount         Int
  version            Int       @default(0)
  issuedAt           DateTime  @default(now()) @db.Timestamptz(3)
  paidAt             DateTime? @db.Timestamptz(3)
  orders             Order[]

  @@index([companyId, issuedAt])
  @@index([paidAt])
  @@map("invoices")
}

// Fulfilment is separate from the order's commercial status.
enum DropStatus {
  WAITING
  DISPATCH_READY
  OUT_FOR_DELIVERY
  DELIVERED
}

model Drop {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  addressId           String         @db.Uuid
  address             CompanyAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  deliveryDate        DateTime       @db.Date
  deliveryTimeMinutes Int
  driverId            String?        @db.Uuid
  driver              User?          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status              DropStatus     @default(WAITING)
  version             Int            @default(0)
  dispatchReadyAt     DateTime?      @db.Timestamptz(3)
  outForDeliveryAt    DateTime?      @db.Timestamptz(3)
  deliveredAt         DateTime?      @db.Timestamptz(3)
  deliveryNote        String         @default("")
  photoUrl            String?
  onTime              Boolean?
  orders              Order[]
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([companyId, addressId, deliveryDate, deliveryTimeMinutes])
  @@index([deliveryDate, deliveryTimeMinutes])
  @@index([driverId, deliveryDate])
  @@map("drops")
}

model OrderLine {
  id             String             @id @default(uuid()) @db.Uuid
  orderId        String             @db.Uuid
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Historical menu item, not a FK: menu categories/items can be removed.
  menuItemId     String             @db.Uuid
  dishId         String             @db.Uuid
  dish           Dish               @relation(fields: [dishId], references: [id], onDelete: Restrict)
  name           String
  sku            String
  temperature    Temperature
  stationId      String?            @db.Uuid
  station        KitchenStation?    @relation(fields: [stationId], references: [id], onDelete: Restrict)
  stationName    String?
  minOrderQty    Int?
  quantity       Int
  dishPriceCents Int
  /// Historical group ids/names/min/max; groups can be replaced in the catalogue.
  groups         Json
  totalCents     Int
  sortOrder      Int
  combinations   OrderCombination[]

  @@index([orderId, sortOrder])
  @@index([dishId])
  @@index([stationId])
  @@map("order_lines")
}

model OrderCombination {
  id             String    @id @default(uuid()) @db.Uuid
  lineId         String    @db.Uuid
  line           OrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  quantity       Int
  /// Saved option ids, names, group ids/names and individual prices.
  options        Json
  unitPriceCents Int
  totalCents     Int
  sortOrder      Int
  prepUnit       PrepUnit?

  @@index([lineId, sortOrder])
  @@map("order_combinations")
}

/// Created atomically on confirmation; worked by the kitchen in M9.
model PrepUnit {
  id            String           @id @default(uuid()) @db.Uuid
  combinationId String           @unique @db.Uuid
  combination   OrderCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  stationId     String?          @db.Uuid
  station       KitchenStation?  @relation(fields: [stationId], references: [id], onDelete: Restrict)
  stationName   String?
  startedAt     DateTime?        @db.Timestamptz(3)
  doneAt        DateTime?        @db.Timestamptz(3)
  startedById   String?          @db.Uuid
  startedBy     User?            @relation("PrepStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  doneById      String?          @db.Uuid
  doneBy        User?            @relation("PrepDoneBy", fields: [doneById], references: [id], onDelete: Restrict)

  @@index([stationId])
  @@map("prep_units")
}

model OrderEvent {
  sequence    Int      @unique @default(autoincrement())
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String
  description String
  actorId     String?  @db.Uuid
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  at          DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, at])
  @@map("order_events")
}

model OrderClosure {
  deliveryDate DateTime @id @db.Date
  closedAt     DateTime @default(now()) @db.Timestamptz(3)
  actorId      String   @db.Uuid
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("order_closures")
}

model EmployeeAllergen {
  employeeId String   @db.Uuid
  allergenId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([employeeId, allergenId])
  @@index([allergenId])
  @@map("employee_allergens")
}

model EmployeeDietaryTag {
  employeeId   String     @db.Uuid
  dietaryTagId String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Restrict)

  @@id([employeeId, dietaryTagId])
  @@index([dietaryTagId])
  @@map("employee_dietary_tags")
}

// ─── Menu (M7) ──────────────────────────────────────────────────────────────────────────────

/// A menu category ("Bowls", "Breakfast"). Secret categories aren't listed; staff open them with the
/// access code (decision 21). Ordered by sortOrder.
model MenuCategory {
  id         String                  @id @default(uuid()) @db.Uuid
  name       String                  @unique
  sortOrder  Int
  isActive   Boolean                 @default(true)
  isSecret   Boolean                 @default(false)
  /// Uppercase; set exactly when the category is secret (CHECK).
  accessCode String?                 @unique
  items      MenuItem[]
  hiddenFor  CompanyHiddenCategory[]
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)

  @@map("menu_categories")
}

/// A dish shown in a category, in order. A dish can be in several categories (decision 20).
model MenuItem {
  id         String                  @id @default(uuid()) @db.Uuid
  categoryId String                  @db.Uuid
  category   MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dishId     String                  @db.Uuid
  /// Restrict: dishes are deactivated, never deleted.
  dish       Dish                    @relation(fields: [dishId], references: [id], onDelete: Restrict)
  sortOrder  Int
  isActive   Boolean                 @default(true)
  hiddenFor  CompanyHiddenMenuItem[]

  @@unique([categoryId, dishId])
  @@index([dishId])
  @@map("menu_items")
}

/// Categories a company doesn't see.
model CompanyHiddenCategory {
  companyId  String       @db.Uuid
  categoryId String       @db.Uuid
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([companyId, categoryId])
  @@index([categoryId])
  @@map("company_hidden_categories")
}

/// Menu items a company doesn't see.
model CompanyHiddenMenuItem {
  companyId  String   @db.Uuid
  menuItemId String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([companyId, menuItemId])
  @@index([menuItemId])
  @@map("company_hidden_menu_items")
}
