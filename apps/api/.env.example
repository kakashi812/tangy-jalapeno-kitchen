# Database. Local Docker Postgres (`docker compose up -d` at the repo root): both URLs are the same.
DATABASE_URL=postgresql://fernleaf:fernleaf@localhost:5432/fernleaf
DATABASE_URL_UNPOOLED=postgresql://fernleaf:fernleaf@localhost:5432/fernleaf

# Or Neon (what production uses). Hosts ending in .neon.tech use Neon's serverless driver.
# Pooled: used by the running app.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (no PgBouncer): used by the Prisma CLI for migrations.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Signs login session tokens. At least 32 random characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Vercel Blob (photos and dish images)
BLOB_READ_WRITE_TOKEN=

# Port for local development (web runs on 3000)
PORT=4000
# Optional locally; required for the authenticated cutoff cron on deployment.
CRON_SECRET=

# Fictional assignment demo: append a small covered week on dashboard access when needed.
# Default enabled; false disables generation without removing existing examples.
DEMO_DATA_ENABLED=true
