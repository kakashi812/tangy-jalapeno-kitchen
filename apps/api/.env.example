# Neon Postgres (Vercel integration creates these)
# Pooled: used by the running app through the Neon adapter
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (no PgBouncer): used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Signs login session tokens. At least 32 random characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Vercel Blob (photos and dish images)
BLOB_READ_WRITE_TOKEN=

# Port for local development (web runs on 3000)
PORT=4000
