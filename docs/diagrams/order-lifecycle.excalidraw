    {
      "id": "n1",
      "type": "text",
      "x": 60,
      "y": 600,
      "width": 1500,
      "height": 26,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aS",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Cut-off = N kitchen working days before the delivery date, at a set time (Asia/Kolkata). Each order saves its own cutoffAt.\nCut-off processing runs whenever orders are read or changed, and via an admin's \"Close orders now\". It is idempotent:\ndrafts are cancelled, placed orders confirmed, prep units and drop membership created exactly once.\nBefore cut-off: Draft and Placed can be edited or cancelled. After cut-off: only an admin (orders.override).",
      "roughness": 1,
      "roundness": null,
      "seed": 1705788106,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Cut-off = N kitchen working days before the delivery date, at a set time (Asia/Kolkata). Each order saves its own cutoffAt.\nCut-off processing runs whenever orders are read or changed, and via an admin's \"Close orders now\". It is idempotent:\ndrafts are cancelled, placed orders confirmed, prep units and drop membership created exactly once.\nBefore cut-off: Draft and Placed can be edited or cancelled. After cut-off: only an admin (orders.override).",
      "textAlign": "left",
      "updated": 1791126508002,
      "version": 1,
      "versionNonce": 478328548,
      "verticalAlign": "top"
    },
